<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.Sparrow"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>
        <!-- Keep the splash colour between the Android splash exit and the first Compose frame. -->
        <item name="android:windowBackground">@color/sparrow_splash_background</item>
        <item name="android:windowLightStatusBar">@bool/sparrow_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/sparrow_light_system_bars</item>
    </style>

    <style
        name="Theme.Sparrow.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">
            @color/sparrow_splash_background
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_sparrow_splash
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.Sparrow
        </item>
    </style>

</resources>