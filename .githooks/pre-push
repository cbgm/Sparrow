#!/usr/bin/env sh

set -e

echo ""
echo "Running Sparrow quality checks before push..."
echo ""

if [ -f "./gradlew" ]; then
    GRADLE="./gradlew"
elif [ -f "./gradlew.bat" ]; then
    GRADLE="./gradlew.bat"
else
    echo "Gradle Wrapper was not found."
    exit 1
fi

"$GRADLE" qualityCheck \
    -x verifyArchitectureReport \
    --console=plain \
    --no-configuration-cache

echo ""
echo "Sparrow quality checks passed."
echo ""
