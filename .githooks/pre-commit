#!/usr/bin/env sh

set -e

echo ""
echo "Running Sparrow formatting and workflow catalog before commit..."
echo ""

# Remember which files were staged before formatting.
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -f "./gradlew" ]; then
    ./gradlew ktlintFormat workflowCatalog --console=plain
elif [ -f "./gradlew.bat" ]; then
    ./gradlew.bat ktlintFormat workflowCatalog --console=plain
else
    echo "Gradle Wrapper was not found."
    exit 1
fi

# Re-stage files that were already part of the commit.
printf '%s\n' "$staged_files" |
while IFS= read -r file; do
    if [ -n "$file" ] && [ -e "$file" ]; then
        git add -- "$file"
    fi
done

# The workflow catalog is generated from the workflow sources and always belongs to the commit.
git add -A -- docs/architecture/workflows

echo ""
echo "Formatting completed, formatted files and the workflow catalog were staged."
echo ""
