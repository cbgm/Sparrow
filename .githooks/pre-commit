#!/usr/bin/env sh

set -e

echo ""
echo "Running Sparrow formatting before commit..."
echo ""

# Remember which files were staged before formatting.
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -f "./gradlew" ]; then
    ./gradlew ktlintFormat --console=plain
elif [ -f "./gradlew.bat" ]; then
    ./gradlew.bat ktlintFormat --console=plain
else
    echo "Gradle Wrapper was not found."
    exit 1
fi

# Re-stage files that were already part of the commit.
printf '%s\n' "$staged_files" |
while IFS= read -r file; do
    if [ -n "$file" ] && [ -e "$file" ]; then
        git add -- "$file"
    fi
done

echo ""
echo "Formatting completed and formatted files were staged."
echo ""
