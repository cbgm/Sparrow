    <string name="feature_settings_circuit">Onion routing</string>
    <string name="feature_settings_circuit_subtitle">How many relays your connection runs through</string>
    <string name="feature_settings_circuit_hint">Each relay only knows the one before and after it. More hops make you harder to trace, but slower and a little less reliable. They only help when the relays are run by different people.</string>
    <string name="feature_settings_circuit_hops">Hops: %1$d</string>
    <string name="feature_settings_circuit_status_building">Building the route…</string>
    <string name="feature_settings_circuit_status_connected">Connected through %1$d hops · round trip %2$d ms</string>
    <string name="feature_settings_circuit_status_unavailable">Route not available right now</string>
