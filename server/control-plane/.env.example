# Local isolated deployment
CONTROL_PLANE_PROJECT_NAME=sparrow-control-plane
CONTROL_PLANE_BIND_ADDRESS=0.0.0.0
CONTROL_PLANE_HTTP_PORT=8390
CONTROL_PLANE_SITE_ADDRESS=:80
FIREBASE_ADMIN_CREDENTIALS=C:/sparrow/firebase-admin.json

NODE_REGISTRY_DATABASE_PASSWORD=replace-for-non-local-deployments
PRESENCE_REDIS_PASSWORD=replace-for-non-local-deployments

