(sparrow_community_routes) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    @root path /
    handle @root {
        redir /index 308
    }

    @index path /index
    handle @index {
        root * /srv
        rewrite * /index.html
        file_server
    }

    @gateway_ws path /v1/gateway
    handle @gateway_ws {
        reverse_proxy gateway:8094 {
            stream_close_delay 5m
        }
    }

    @gateway_blobs path /v1/blobs /v1/blobs/*
    handle @gateway_blobs {
        reverse_proxy gateway:8094
    }

    @gateway_info path /v1/gateway/info /v1/control-planes
    handle @gateway_info {
        reverse_proxy gateway:8094
    }

    @gateway_health path /health/gateway
    handle @gateway_health {
        rewrite * /health/ready
        reverse_proxy gateway:8094
    }

    @federation path /v1/federation /v1/federation/*
    handle @federation {
        reverse_proxy federation:8093
    }

    @federation_health path /health/federation
    handle @federation_health {
        rewrite * /health/ready
        reverse_proxy federation:8093
    }

    @mailboxes path /v1/mailboxes /v1/mailboxes/*
    handle @mailboxes {
        reverse_proxy mailbox:8092
    }

    @mailbox_health path /health/mailbox
    handle @mailbox_health {
        rewrite * /health/ready
        reverse_proxy mailbox:8092
    }

    respond 404
}

{$COMMUNITY_NODE_SITE_ADDRESS} {
    import sparrow_community_routes
}

:8080 {
    import sparrow_community_routes
}
