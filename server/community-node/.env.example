# Every node needs its own Compose project name and host ports.
COMMUNITY_NODE_PROJECT_NAME=sparrow-community-node
COMMUNITY_NODE_BIND_ADDRESS=0.0.0.0
COMMUNITY_NODE_HTTP_PORT=8490
COMMUNITY_NODE_SITE_ADDRESS=:80

# Local isolation test. On Docker Desktop and modern Linux Docker this reaches
# the separately published control-plane Caddy endpoint.
CONTROL_PLANE_URL=http://host.docker.internal:8390
CLIENT_ENDPOINT=ws://host.docker.internal:8490/v1/gateway
FEDERATION_ENDPOINT=http://host.docker.internal:8490
MAILBOX_ENDPOINT=http://host.docker.internal:8490

MAILBOX_DIAGNOSTIC_PORT=8492
FEDERATION_DIAGNOSTIC_PORT=8493
GATEWAY_DIAGNOSTIC_PORT=8494
MAILBOX_DATABASE_PORT=5636
FEDERATION_DATABASE_PORT=5638

MAILBOX_DATABASE_PASSWORD=replace-for-non-local-deployments
FEDERATION_DATABASE_PASSWORD=replace-for-non-local-deployments
FEDERATION_INTERNAL_API_TOKEN=replace-with-a-random-node-local-token
GATEWAY_INTERNAL_API_TOKEN=replace-with-a-different-random-node-local-token

# Production override
# COMMUNITY_NODE_DOMAIN=node-b.example.com
# CONTROL_PLANE_URL=https://control.sparrow.example
# MAILBOX_DATABASE_PASSWORD_FILE=./secrets/mailbox-database-password.txt
# FEDERATION_DATABASE_PASSWORD_FILE=./secrets/federation-database-password.txt
# FEDERATION_INTERNAL_API_TOKEN_FILE=./secrets/federation-internal-api-token.txt
# GATEWAY_INTERNAL_API_TOKEN_FILE=./secrets/gateway-internal-api-token.txt
