{$SPARROW_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    @gateway_ws path /v1/gateway
    handle @gateway_ws {
        reverse_proxy gateway:8094 {
            stream_close_delay 5m
        }
    }

    @gateway_info path /v1/gateway/info
    handle @gateway_info {
        reverse_proxy gateway:8094
    }

    @push path /push /push/*
    handle @push {
        reverse_proxy push:8095
    }

    @federation path /v1/federation /v1/federation/*
    handle @federation {
        reverse_proxy federation:8093
    }

    @mailboxes path /v1/mailboxes /v1/mailboxes/*
    handle @mailboxes {
        reverse_proxy mailbox:8092
    }

    @nodes path /v1/nodes /v1/nodes/*
    handle @nodes {
        reverse_proxy node-registry:8090
    }

    @presence path /v1/routes /v1/routes/*
    handle @presence {
        reverse_proxy presence-directory:8091
    }

    @node_push path /v1/node-push /v1/node-push/*
    handle @node_push {
        reverse_proxy push:8095
    }

    respond 404
}
