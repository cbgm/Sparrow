{$SPARROW_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    @gateway_ws path /v1/circuit
    handle @gateway_ws {
        reverse_proxy gateway:8094 {
            stream_close_delay 5m
        }
    }

    @gateway_blobs path /v1/blobs /v1/blobs/*
    handle @gateway_blobs {
        reverse_proxy gateway:8094
    }

    @gateway_info path /v1/relay
    handle @gateway_info {
        reverse_proxy gateway:8094
    }

    @link_preview path /v1/link-preview /v1/link-preview/*
    handle @link_preview {
        reverse_proxy gateway:8094
    }

    @exchange_rates path /v1/exchange-rates
    handle @exchange_rates {
        reverse_proxy gateway:8094
    }

    @federation path /v1/federation /v1/federation/*
    handle @federation {
        reverse_proxy federation:8093
    }

    @mailboxes path /v1/mailboxes /v1/mailboxes/*
    handle @mailboxes {
        reverse_proxy mailbox:8092
    }

    @nodes path /v1/nodes /v1/nodes/*
    handle @nodes {
        reverse_proxy node-registry:8090
    }

    @presence path /v1/alias-claims /v1/invitation-routes
    handle @presence {
        reverse_proxy presence-directory:8091
    }

    respond 404
}
